# Where the real backend server is, and the dev-only token to talk to it
# (CLAUDE.md Section 6.3: development authentication, not real accounts).
# Matches apps/server's own DEV_TOKENS value by default - change both
# together if you change either.
BACKEND_URL=http://localhost:8080
BACKEND_DEV_TOKEN=local-dev-only-smoke-test-token
